# cTrader Open API public application identifier.
CTRADER_CLIENT_ID=

# Keep this only in your local .env or secret manager. Never commit it.
CTRADER_CLIENT_SECRET=

# Demo account identifier returned by cTrader account authorization.
CTRADER_ACCOUNT_ID=

# Local 0600 token file produced by ctrader-oauth-bootstrap; never commit it.
CTRADER_TOKEN_FILE=

# Provisioning only: registered loopback callback URL. The unattended bot
# does not need this variable.
CTRADER_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback

# Use the documented demo proxy only during development.
CTRADER_ENVIRONMENT=demo
CTRADER_SERIALIZATION=JSON

# Binance public Spot market data does not require an API key.
# Optional key; public market-data calls work without it.
BINANCE_API_KEY=

# Twelve Data API key for live market data (free tier: 800 requests/day).
# Sign up at https://twelvedata.com to get a key.
TWELVE_DATA_API_KEY=

# FCS API key for silver, oil, and indices (free tier: 500 requests/month).
# Sign up at https://fcsapi.com to get a key.
FCS_API_KEY=

# FINNHUB API key for live market (free tier: 60 requests/minute).
# Sign up at https://finnhub.io to get a key.
FINNHUB_API_KEY=

# Infrastructure (Docker Compose provides these by default)
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgres://tradex:tradex_dev@localhost:5432/tradex?sslmode=disable
POSTGRES_DB=tradex
POSTGRES_USER=tradex
POSTGRES_PASSWORD=tradex_dev
